				maxchar = 100
				values = {"AIML","CSE","IT","EEE","AIDS","ECE"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Year_of_Study
			(
				type = radiobuttons
				maxchar = 100
				values = {"I","II","III","IV"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Phone_Number
			(
    			type = phonenumber
				displayname = "Phone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Mentor_Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Photo
