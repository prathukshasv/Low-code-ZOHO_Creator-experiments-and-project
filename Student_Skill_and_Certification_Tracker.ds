				start date = Issue_Date
				end date = Expiry_Date
			)
		}
	}


		 functions
		 {
			 Deluge
			 {
				 string getCertificationStatus(date expiryDate)
                 {
                 	if(expiryDate == null)
                 	{
                 		status = "Valid";
                 	}
                 	else if(expiryDate < zoho.currentdate)
                 	{
                 		status = "Expired";
                 	}
                 	else if(expiryDate <= zoho.currentdate.addDay(30))
                 	{
                 		status = "Expiring Soon";
                 	}
                 	else
                 	{
                 		status = "Valid";
                 	}
                 	return status;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Valid_Certificate_Query as "Valid_Certificate_Query"
			{
				type =  form
				form = Certification

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											validCerts = Certification[Certification_Status == "Valid"] range from 1 to 10;
										alert "Valid certificates found (first 10): " + validCerts.count();
						)
					}
				}

			}
			Validate_dates as "Validate_dates"
			{
				type =  form
				form = Certification

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Expiry_Date != null && input.Expiry_Date < input.Issue_Date)
										{
											alert "Expiry date must be after the issue date";
											cancel submit;
										}
						)
					}
				}

			}
			Check_Duplicate as "Check_Duplicate"
			{
				type =  form
				form = Certification

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											dup = Certification[Student == input.Student && Certification_Name == input.Certification_Name];
										if(dup.count() > 0)
										{
											alert "This certificate is already recorded for this student";
											cancel submit;
										}
						)
					}
				}

			}
			Set_Status as "Set_Status"
			{
				type =  form
				form = Certification

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											input.Certification_Status = thisapp.getCertificationStatus(input.Expiry_Date);
						)
					}
				}

			}
			Notify_Student as "Notify_Student"
			{
				type =  form
				form = Certification

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											stu = Student_Profile[ID == input.Student];
										sendmail
										[
											from :zoho.adminuserid
											to :stu.Email
											subject :"Certificate submitted: " + input.Certification_Name
											message :"Dear " + stu.Student_Name + ", your certificate " + input.Certification_Name + " has been submitted and is waiting for verification."
										]
						)
					}
				}

			}
			Check_API as "Check_API"
			{
				type =  form
				form = Certification

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											resp = invokeurl
										[
											url :"https://jsonplaceholder.typicode.com/users/1"
											type :GET
										];
										alert "REST API connected. Test user: " + resp.get("name");
						)
					}
				}

			}
		}

		schedule
		{
			Expiry_Remainder as "Expiry_Remainder"
			{
				type =  schedule
				start = "2026-10-20 00:42:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						today = zoho.currentdate;
										limit = zoho.currentdate.addDay(30);
										for each  c in Certification[Expiry_Date >= today && Expiry_Date <= limit]
										{
											stu = Student_Profile[ID == c.Student];
											sendmail
											[
												from :zoho.adminuserid
												to :stu.Email
												subject :"Certificate expiring soon: " + c.Certification_Name
												message :"Dear " + stu.Student_Name + ", your certificate " + c.Certification_Name + " expires on " + c.Expiry_Date + ". Please renew it."
											]
										}
					)
					}
				}
			}
		}

		approval
		{
			Verify_Certificate as "Verify_Certificate"
			{
				type =  approval
				form = Certification
				display fields = [Certificate_ID,Student,Skill,Certification_Name,Issuing_Organisation,Credential_ID,Issue_Date]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
						actions 
						{
						on load
						(
							rec = Certification[ID == input.ID];
												rec.Verification_Status="Verified";
						)
						}
						actions 
						{
						on load
						(
							rec = Certification[ID == input.ID];
												rec.Verification_Status="Verified";
						)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}

		blueprint
		{
    			Renewal_Stage as "Renewal_Stage"
    			{
        			type = Blueprint
        			form = Certification
        			start
        			{
            			start stage = "Not Due"
            			chart data
            			{
                			from port : B
                			to port   : T3
                			position  : "0 0"
                			path      : [27.849999999999994,36.84,27.849999999999994,46.84,27.849999999999994,54.67,29.857662455240845,54.67,29.857662455240845,62.5,29.857662455240845,72.5]
            			}
        			}
        			stages
