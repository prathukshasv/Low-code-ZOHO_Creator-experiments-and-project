 application "Student Skill and Certification Tracker"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Certification
		{
			success message = "Certification Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Certificate_ID
			(
    			type = autonumber
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Student
			(
				type = picklist	
				values  = Student_Profile.ID
    			displayformat = [" " + Student_Name.prefix + " " + Student_Name.first_name + " " + Student_Name.last_name + " " + Student_Name.suffix]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Skill
			(
				type = picklist	
				values  = Skill_Master.ID
    			displayformat = [Skill_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Certification_Name
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Issuing_Organisation
			(
				type = picklist
				maxchar = 100
				values = {"NPTEL","Zoho","Coursera","Oracle","Microsoft","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Credential_ID
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Issue_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expiry_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Score
			(
    			type = percentage
				displayname = "Score_Percentage"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have File_upload
			(
    			type = upload file
				displayname = "File upload"
    			file count = 10
				browse = local_drive, google_docs
	 			row = 1
	 			column = 1   
				width = medium
			)
			Verification_Status
			(
				type = picklist
				maxchar = 100
				values = {"Submitted","Verified","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Certification_Status
			(
				type = picklist
				maxchar = 100
				values = {"Valid","Expiring Soon","Expired"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Renewal_Storage
			(
				type = picklist
				maxchar = 100
				values = {"Not Due","Renewal Pending","Renewed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Not Due","Renewal Pending","Renewed"}
			}
		}
