		timeline Certification_Timeline
		{
			displayName = "Certification_Timeline"
			show all rows from Certification    
			(
				Certificate_ID
				Student
				Skill
				Certification_Name
				Issuing_Organisation
				Credential_ID
				Issue_Date
				Expiry_Date
				Score as "Score_Percentage"
