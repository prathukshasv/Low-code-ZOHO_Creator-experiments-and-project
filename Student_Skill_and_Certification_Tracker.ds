				Skill_Name as "Skill_Name "
				Skill_Category
				Skill_Description
			)
		}
		default list Student_Profile_Report
		{
			displayName = "Student_Profile Report"
			show all rows from Student_Profile    
			(
				Student_Name 
				Register_Number
				Department as "Department "
				Year_of_Study
				Email
				Phone_Number as "Phone"
				(
					displayformat = plainnumber 
				)
