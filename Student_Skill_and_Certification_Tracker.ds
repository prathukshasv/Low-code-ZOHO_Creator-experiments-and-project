			"Mentor_Access"
			{
				name = "Mentor_Access"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Mentors can view and verify all student certification records\n"
				ModulePermissions
				{
					Skill_Assessment
					{
